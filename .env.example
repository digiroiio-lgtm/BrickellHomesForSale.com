# Search Console HTML verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools meta verification token.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# IndexNow key (see scripts/indexnow.cjs); not read by the site itself.
INDEXNOW_KEY=
# Optional approved public inbox and WhatsApp URL for direct contact tracking.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_URL=
