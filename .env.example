# Public GA4 measurement ID and Search Console HTML verification token.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# HTTPS receiving endpoint; provision before enabling lead submissions in production.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Public, factual privacy details required before an inquiry can be accepted.
# The recipient is the person or organization receiving the webhook payload.
NEXT_PUBLIC_SITE_OPERATOR_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_LEAD_RECIPIENT_NAME=
NEXT_PUBLIC_LEAD_RETENTION_PERIOD=
# Optional approved public inbox and WhatsApp URL for direct contact tracking.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_URL=
